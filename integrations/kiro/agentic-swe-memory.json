{
  "version": "v1",
  "hooks": [
    {
      "name": "agentic-swe-memory-start",
      "trigger": "SessionStart",
      "action": {
        "type": "command",
        "command": "node .agentic-swe/scripts/host-lifecycle.cjs --host kiro --event start"
      }
    },
    {
      "name": "agentic-swe-policy",
      "trigger": "PreToolUse",
      "action": {
        "type": "command",
        "command": "node .agentic-swe/scripts/hook-pre-tool-policy.cjs --host kiro"
      },
      "timeout": 10
    },
    {
      "name": "agentic-swe-memory-stop",
      "trigger": "Stop",
      "action": {
        "type": "command",
        "command": "node .agentic-swe/scripts/host-lifecycle.cjs --host kiro --event stop"
      }
    }
  ]
}

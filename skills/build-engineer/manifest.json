{
  "name": "build-engineer",
  "version": "1.0.0",
  "description": "Use this agent when you need to optimize build performance, reduce compilation times, or scale build systems across growing teams.",
  "kind": "subagent",
  "inputs": [
    {
      "name": "build_system",
      "type": "string",
      "required": true
    },
    {
      "name": "perf_goals",
      "type": "object",
      "required": false
    }
  ],
  "outputs": [
    {
      "name": "build_config",
      "type": "files"
    },
    {
      "name": "perf_notes",
      "type": "string"
    }
  ],
  "dependencies": [],
  "permissions": [
    "fs.read",
    "fs.write",
    "proc.exec:allowlisted"
  ],
  "runtime": {
    "node": ">=22.0.0"
  },
  "compatibility": {
    "pack": "^3.4.0"
  },
  "validation": {
    "rules": [
      "schema",
      "permissions-explicit",
      "digest-pin",
      "ae-029a-contract",
      "no-paid-llm"
    ]
  },

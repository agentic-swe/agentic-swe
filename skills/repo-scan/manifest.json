{
  "name": "repo-scan",
  "version": "1.0.0",
  "description": "Produce a structured snapshot of the target repository for rapid task analysis.",
  "kind": "command",
  "inputs": [
    {
      "name": "repo_root",
      "type": "string",
      "required": true,
      "description": "Repository path to scan"
    }
  ],
  "outputs": [
    {
      "name": "snapshot",
      "type": "object"
    },
    {
      "name": "signals",
      "type": "array"
    }
  ],
  "dependencies": [],
  "permissions": [
    "fs.read"
  ],
  "runtime": {
    "node": ">=22.0.0"
  },
  "compatibility": {
    "pack": "^3.4.0"
  },
  "validation": {
    "rules": [
      "schema",
      "permissions-explicit",
      "digest-pin",
      "ae-029a-contract",
      "no-paid-llm"
    ]
  },
  "provenance": {
    "origin": "first-party",
    "license": "MIT",
    "authors": [
      "agentic-swe"
    ]
  },
  "maintainer": "agentic-swe",
  "digest": "1950bee0d916b39f367642c512f2882bf79902da02a62d5b4f20ff5c47c7892a",
  "eval_attestation": {
    "suite_id": "ae-029a-first-party-contracts",
    "result_digest": "677d8a6cbf773a789b260ddd8dcd9f1dbae51f4a4094096622b516b0bc9dbefc",
    "timestamp": "2026-11-12T00:00:00.000Z"
  }
}

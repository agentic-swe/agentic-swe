{
  "name": "devops-engineer",
  "version": "1.0.0",
  "description": "Use this agent when building or optimizing infrastructure automation, CI/CD pipelines, containerization strategies, and deployment workflows to accelerate software delivery while maintaining reliability and security.",
  "kind": "subagent",
  "inputs": [
    {
      "name": "pipeline_goal",
      "type": "string",
      "required": true
    },
    {
      "name": "environment",
      "type": "string",
      "required": false
    }
  ],
  "outputs": [
    {
      "name": "pipeline_config",
      "type": "files"
    },
    {
      "name": "runbook",
      "type": "string"
    }
  ],
  "dependencies": [],
  "permissions": [
    "fs.read",
    "fs.write",
    "proc.exec:allowlisted"
  ],
  "runtime": {
    "node": ">=22.0.0"
  },
  "compatibility": {
    "pack": "^3.4.0"
  },
  "validation": {
    "rules": [
      "schema",
      "permissions-explicit",
      "digest-pin",
      "ae-029a-contract",
      "no-paid-llm"
    ]
  },

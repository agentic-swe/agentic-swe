{
  "name": "backend-developer",
  "version": "1.0.0",
  "description": "Use this agent when building server-side APIs, microservices, and backend systems that require robust architecture, scalability planning, and production-ready implementation.",
  "kind": "subagent",
  "inputs": [
    {
      "name": "task",
      "type": "string",
      "required": true,
      "description": "Backend implementation request"
    },
    {
      "name": "repo_context",
      "type": "object",
      "required": false,
      "description": "Optional repo signals"
    }
  ],
  "outputs": [
    {
      "name": "implementation_plan",
      "type": "string"
    },
    {
      "name": "code_changes",
      "type": "diff"
    }
  ],
  "dependencies": [],
  "permissions": [
    "fs.read",
    "fs.write",
    "proc.exec:allowlisted"
  ],
  "runtime": {
    "node": ">=22.0.0"
  },
  "compatibility": {
    "pack": "^3.4.0"
  },
  "validation": {
    "rules": [
      "schema",
      "permissions-explicit",
      "digest-pin",
      "ae-029a-contract",
      "no-paid-llm"
    ]
  },
  "provenance": {
    "origin": "first-party",
    "license": "MIT",
    "authors": [
      "agentic-swe"
    ]
  },
  "maintainer": "agentic-swe",

{
  "name": "code-reviewer",
  "version": "1.0.0",
  "description": "Use this agent when you need to conduct comprehensive code reviews focusing on code quality, security vulnerabilities, and best practices.",
  "kind": "subagent",
  "inputs": [
    {
      "name": "diff",
      "type": "string",
      "required": true,
      "description": "Change set to review"
    },
    {
      "name": "focus",
      "type": "string",
      "required": false
    }
  ],
  "outputs": [
    {
      "name": "findings",
      "type": "array"
    },
    {
      "name": "summary",
      "type": "string"
    }
  ],
  "dependencies": [],
  "permissions": [
    "fs.read",
    "fs.write",
    "proc.exec:allowlisted"
  ],
  "runtime": {
    "node": ">=22.0.0"
  },
  "compatibility": {
    "pack": "^3.4.0"
  },
  "validation": {
    "rules": [
      "schema",
      "permissions-explicit",
      "digest-pin",
      "ae-029a-contract",
      "no-paid-llm"
    ]
  },
  "provenance": {
    "origin": "first-party",
    "license": "MIT",
    "authors": [
      "agentic-swe"
    ]
  },
  "maintainer": "agentic-swe",
  "digest": "38044cfbb4d1fb2a0fac8639118211b6baf947cda7136a847dd799abfff4aed5",
  "eval_attestation": {

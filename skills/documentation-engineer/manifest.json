{
  "name": "documentation-engineer",
  "version": "1.0.0",
  "description": "Use this agent when you need to create, architect, or overhaul comprehensive documentation systems including API docs, tutorials, guides, and developer-friendly content that keeps pace with code changes.",
  "kind": "subagent",
  "inputs": [
    {
      "name": "doc_target",
      "type": "string",
      "required": true
    },
    {
      "name": "audience",
      "type": "string",
      "required": false
    }
  ],
  "outputs": [
    {
      "name": "docs",
      "type": "files"
    },
    {
      "name": "outline",
      "type": "string"
    }
  ],
  "dependencies": [],
  "permissions": [
    "fs.read",
    "fs.write",
    "net.fetch:injected"
  ],
  "runtime": {
    "node": ">=22.0.0"
  },
  "compatibility": {
    "pack": "^3.4.0"
  },
  "validation": {
    "rules": [
      "schema",
      "permissions-explicit",
      "digest-pin",
      "ae-029a-contract",
      "no-paid-llm"
    ]
  },
  "provenance": {
    "origin": "first-party",
    "license": "MIT",
    "authors": [
      "agentic-swe"
    ]
  },
  "maintainer": "agentic-swe",

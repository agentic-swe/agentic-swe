{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentic-swe.github.io/schemas/model-gateway-config.schema.json",
  "title": "Model Gateway Config",
  "type": "object",
  "required": ["provider", "models"],
  "additionalProperties": true,
  "properties": {
    "provider": { "type": "string", "minLength": 1 },
    "models": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }
        ]
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["tools", "json_schema", "vision", "context_tokens", "streaming"],
        "properties": {
          "tools": { "type": "boolean" },
          "json_schema": { "type": "boolean" },
          "vision": { "type": "boolean" },
          "context_tokens": { "type": "number", "exclusiveMinimum": 0 },
          "streaming": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "timeout_ms": { "type": "number", "exclusiveMinimum": 0 },
    "max_retries": { "type": "integer", "minimum": 0 },
    "max_repair_attempts": { "type": "integer", "minimum": 0 },
    "fallback": { "type": "boolean" },
    "base_url": { "type": "string" }
  }
}

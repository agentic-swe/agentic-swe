{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentic-swe.github.io/schemas/journal-event.schema.json",
  "title": "Journal Event Envelope and Side Payloads",
  "description": "Typed journal events for ADR-004a / AE-020a. Snapshot events embed full state; side events carry payload only.",
  "definitions": {
    "snapshotState": {
      "type": "object",
      "description": "Full projected state embedded by commitState."
    },
    "leaseReclaimedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["previous_holder", "previous_pid", "previous_epoch", "new_epoch", "reason"],
      "properties": {
        "previous_holder": { "type": "string" },
        "previous_pid": { "type": "integer" },
        "previous_epoch": { "type": "integer", "minimum": 1 },
        "new_epoch": { "type": "integer", "minimum": 1 },
        "reason": { "type": "string", "enum": ["expired_dead"] }
      }
    },
    "policyDecidedPayload": {
      "type": "object",
      "required": ["decision", "rule_id", "policy_digest"],
      "properties": {
        "decision": { "type": "string", "enum": ["allow", "deny", "require_approval"] },
        "rule_id": { "type": "string", "minLength": 1 },
        "policy_digest": { "type": "string", "minLength": 16 },
        "risk_class": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "reason": { "type": "string" },
        "input_summary": { "type": "string" },
        "code": { "type": "string" },
        "critical_failure": { "type": "boolean" },
        "tool_name": { "type": "string" },
        "state": { "type": ["string", "null"] },
        "track": { "type": ["string", "null"] },
        "op": { "type": "string" },
        "provider": { "type": "string" },
        "cost_source": { "type": "string" },
        "flags": { "type": "object" },
        "tool_input": { "type": "object" }
      },
      "additionalProperties": true
    },
    "usageRecordedPayload": {
      "type": "object",
      "required": ["provider", "model"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "input": { "type": ["number", "null"] },
        "output": { "type": ["number", "null"] },
        "cache_read": { "type": ["number", "null"] },
        "usage_source": { "type": "string", "enum": ["provider", "absent"] },
        "usd": { "type": ["number", "null"] },
        "cost_source": { "type": "string", "enum": ["local", "price_table", "provider", "unknown"] },
        "latency_ms": { "type": "number", "minimum": 0 },
        "status": { "type": "string", "enum": ["ok", "error", "timeout"] },
        "finish_reason": { "type": "string", "enum": ["stop", "length", "tool_calls", "error"] },
        "usage_known": { "type": "boolean" },
        "error_code": { "type": "string" },
        "capability": { "type": "string" },
        "fallback_from": { "type": "string" }
      },
      "additionalProperties": true
    },
    "toolRequestedPayload": {
      "type": "object",
      "required": ["tool_id"],
      "properties": {
        "tool_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "toolCompletedPayload": {
      "type": "object",
      "required": ["tool_id"],
      "properties": {
        "tool_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "toolReconciledPayload": {
      "type": "object",
      "required": ["tool_id", "idempotency_key", "outcome"],
      "properties": {
        "tool_id": { "type": "string", "minLength": 1 },
        "idempotency_key": { "type": "string", "minLength": 1 },
        "outcome": { "type": "string", "enum": ["escalated"] }
      },
      "additionalProperties": true
    },
    "testSidePayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "n": { "type": "number" },
        "note": { "type": "string" }
      },
      "anyOf": [
        { "required": ["n"] },
        { "required": ["note"] }
      ]
    },
    "improvementProposedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposal_id", "summary", "baseline_ref", "actor"],
      "properties": {
        "proposal_id": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "baseline_ref": {
          "type": "string",
          "minLength": 1,
          "description": "Known baseline identifier (commit SHA, scorecard path, or manifest digest)."
        },
        "actor": { "type": "string", "minLength": 1 },
        "scope": {
          "type": "string",
          "enum": ["platform", "skill", "policy", "other"]
        },
        "target_paths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "improvementEvaluatedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposal_id", "baseline_ref", "outcome", "regression"],
      "properties": {
        "proposal_id": { "type": "string", "minLength": 1 },
        "baseline_ref": { "type": "string", "minLength": 1 },
        "outcome": {
          "type": "string",
          "enum": ["pass", "fail", "regress", "inconclusive"]
        },
        "regression": { "type": "boolean" },
        "scorecard_ref": { "type": "string", "minLength": 1 },
        "compare_digest": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" }
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentic-swe.github.io/schemas/skill-manifest.schema.json",
  "title": "AutoEng Skill Manifest (ADR-010)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "version",
    "description",
    "inputs",
    "outputs",
    "dependencies",
    "permissions",
    "runtime",
    "compatibility",
    "validation",
    "provenance",
    "maintainer"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,64}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([.-][0-9A-Za-z.-]+)?$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "kind": {
      "type": "string",
      "enum": [
        "subagent",
        "command",
        "phase",
        "prompt",
        "plugin",
        "tool",
        "executable",
        "docs",
        "unknown"
      ]
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "description": { "type": "string" }
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "description": { "type": "string" }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "range"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "range": { "type": "string", "minLength": 1 }
        }
      }
    },
    "permissions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node"],
      "properties": {
        "node": { "type": "string", "minLength": 1 },
        "os": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pack"],
      "properties": {
        "pack": { "type": "string", "minLength": 1 },
        "hosts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rules"],
      "properties": {
        "rules": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin"],
      "properties": {
        "origin": {
          "type": "string",
          "enum": ["first-party", "third-party", "generated", "unknown"]
        },
        "license": { "type": "string" },
        "authors": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "upstream_repo": { "type": "string" },
        "upstream_commit": { "type": "string" }
      }
    },
    "maintainer": {
      "type": "string",
      "minLength": 1
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "eval_attestation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "suite_id": { "type": "string", "minLength": 1 },
        "result_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "timestamp": { "type": "string", "minLength": 1 }
      }
    }
  }
}

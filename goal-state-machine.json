    ["goal-execute", "goal-gate"],
    ["goal-execute", "goal-escalated"],
    ["goal-verify", "goal-execute"],
    ["goal-verify", "goal-approval"],
    ["goal-verify", "goal-escalated"],
    ["goal-gate", "goal-execute"],
    ["goal-gate", "goal-failed"],
    ["goal-approval", "goal-met"],
    ["goal-approval", "goal-execute"],
    ["goal-escalated", "goal-execute"],
    ["goal-escalated", "goal-failed"]
  ]
}

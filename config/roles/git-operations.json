{
  "schema_version": 1,
  "id": "git-operations",
  "description": "Branches, worktrees, remote sync and conflict resolution.",
  "agents": [
    "agents/git-operations-agent.md"
  ],
  "agent_types": [
    "git-operations-agent"
  ],
  "tools": [
    "read",
    "search",
    "edit",
    "shell",
    "plan"
  ],
  "privileged_actions": [
    "github.branch.push"
  ],
  "budget": {
    "max_spawns_per_phase": 0
  },
  "review": {
    "required": false
  },
  "escalation": {
    "to": "hypervisor",
    "when": [
      "conflict",
      "protected-branch"
    ]
  }
}
